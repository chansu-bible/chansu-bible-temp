# 이 파일을 .env로 복사하고 값을 채운다. .env는 커밋되지 않는다.
OPENAI_API_KEY=
# 그림 모델과 품질 (비워 두면 기본값: gpt-image-2.5-sunburst, high)
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=
# 낭독 음성 모델과 목소리 (비워 두면 기본값: gpt-4o-mini-tts, cedar)
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# 글 모델 (비워 두면 기본값: 작성 gpt-6.1-sol, 검수 gpt-6-astra)
OPENAI_WRITER_MODEL=
OPENAI_REVIEWER_MODEL=
# 질문하기(동기화 서버)의 모델과 계정마다 하루 질문 수 (비워 두면 기본값: 작성 모델, 20)
ASK_MODEL=
ASK_DAILY_LIMIT=
# 질문하기가 읽는 책 묶음(<책 id>.json)이 든 폴더 (비워 두면 기본값: app/public/content)
BUNDLE_DIR=
